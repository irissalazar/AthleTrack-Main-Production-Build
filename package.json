{
  "name": "athletrack",
  "private": true,
  "version": "1.0.0",
  "description": "UC AthleTrack — sports training and athlete monitoring with predictive analytics for University of the Cordilleras student-athletes",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node server/index.js\" \"vite\"",
    "predev": "node server/setup.js",
    "setup": "node server/setup.js --force",
    "server": "cross-env NODE_ENV=production node server/index.js",
    "client": "vite",
    "build": "cross-env NODE_ENV=production vite build",
    "preview": "cross-env NODE_ENV=production vite preview",
    "seed": "node server/seed.js --force",
    "restore": "node server/restore.js",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
